# Conway API Configuration
CONWAY_API_KEY=your_api_key_here
CONWAY_BASE_URL=https://api.conway.tech

# Blockchain Configuration
CHAIN_TYPE=evm
# Options: evm (Ethereum/Base) or solana

# Wallet (auto-generated on first run, but can be overridden)
# WALLET_ADDRESS=0x...
# PRIVATE_KEY=0x...

# AI Model Configuration
DEFAULT_MODEL=gpt-5.2
# Options: gpt-5.2, claude-opus-4.6, gemini-3, kimi-k2.5

# Survival Configuration (values in cents, $10.00 = 1000)
MINIMUM_RESERVE=1000
MAX_SINGLE_TRANSFER=5000
MAX_HOURLY_TRANSFERS=10000
MAX_DAILY_TRANSFERS=25000
MAX_X402_PAYMENT=100

# Heartbeat Configuration
HEARTBEAT_INTERVAL=300
# Interval in seconds (5 minutes)

# Logging
LOG_LEVEL=info
# Options: debug, info, warn, error

# Knowledge Exchange
KNOWLEDGE_EXCHANGE_PATH=~/.automaton/knowledge_exchange.db
MAX_DECISIONS=500
MAX_INSTINCTS=50
DISTILL_INTERVAL=10
# Distill instincts every N turns

# GitHub Integration (optional)
GITHUB_TOKEN=your_github_token_here
# For github_search and github_clone tools

# Security
ALLOW_SELF_MODIFICATION=true
ALLOW_REPLICATION=true
AUDIT_LOG_ENABLED=true

# Performance
MAX_CONCURRENT_TOOLS=5
INFERENCE_TIMEOUT=30000
# Timeout in milliseconds
